# Kavach environment variables (see docs/handoffs/CONVENTIONS.md)

# LLM (one of OPENAI_API_KEY or ANTHROPIC_API_KEY required for agents)
OPENAI_API_KEY=sk-placeholder
ANTHROPIC_API_KEY=sk-ant-placeholder
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1

# DataHub
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_TOKEN=placeholder-token

# GitHub (Fixer PR flow)
GITHUB_PAT=ghp_placeholder
DEMO_PIPELINE_REPO=doPrashams/kavach-demo-pipeline

# Optional comms
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/placeholder

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
